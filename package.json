{
  "name": "handout-generator",
  "version": "0.1.0",
  "description": "Generates branded clinic handout PDFs from HTML templates",
  "main": "server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --watch --env-file-if-exists=.env server.js",
    "verify": "node tools/verify-pages.js",
    "check:sheet": "node --env-file-if-exists=.env tools/check-sheet.js",
    "check:ac": "node --env-file-if-exists=.env tools/check-ac.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.600.0",
    "@fontsource/figtree": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "express": "^4.19.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^9.0.4",
    "puppeteer": "^23.0.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.33.0"
  }
}
