# ---------------------------------------------------------------------------
# Handout Generator — environment. Copy to .env and fill in.
# Run `npm run check:sheet` and `npm run check:ac` to verify as you go.
# ---------------------------------------------------------------------------

PORT=3000
# Public URL of this service. Used to build retry links in exception notices.
SERVICE_BASE_URL=https://handouts.example.com

# --- the webhook the public request form posts to ---------------------------
# Generate with: openssl rand -hex 32
WEBHOOK_SECRET=
WEBHOOK_SECRET_HEADER=x-handout-secret

# Optional: gate the doctor-facing form page with ?key=... so the deployed app
# is not open to the whole internet. Does not apply to /handout/*.
ACCESS_KEY=

# --- tracking sheet: referral links + discount codes ------------------------
# The source of truth. Both values are created by hand per practitioner, so the
# sheet is where that decision is recorded; the doctor supplies only their email.
SHEETS_MODE=service_account
SHEETS_SPREADSHEET_ID=
SHEETS_RANGE=Sheet1!A:Z
# A Google Cloud service account with the Sheets API enabled. Then SHARE THE
# SHEET with this address as Viewer — the step that is usually missed.
SHEETS_SA_EMAIL=
SHEETS_SA_PRIVATE_KEY=
# Offline/testing alternative. Accepts a URL or a local file path.
# SHEETS_MODE=csv_url
# SHEETS_CSV_URL=./local/affiliates.csv
# Column headings, matched by name so reordering the sheet is safe.
SHEETS_COL_EMAIL=email,practitioner email,contact email
SHEETS_COL_REFERRAL=shopify_link,shopify link,referral link,referral url
SHEETS_COL_CODE=affiliate_code,affiliate code,discount code,coupon code,coupon,code
# The affiliate group carries the discount size, e.g. "Pro Program - Share (10%)".
# A 0% group means that practitioner gets no discount code printed at all.
SHEETS_COL_PERCENT=affiliate_group (%=discount),affiliate_group,affiliate group,discount percent,discount %
SHEETS_CACHE_TTL_MS=60000

# --- logo intake ------------------------------------------------------------
# Uploads come as multipart from the built-in form. Automations (Zapier, Tally,
# Fillout) pass a hosted file URL instead, sent as logo_url. Private and
# link-local addresses are always refused, so the service cannot be aimed at
# your own network by a form submission.
LOGO_MAX_BYTES=10485760
LOGO_FETCH_TIMEOUT_MS=15000

# --- ActiveCampaign: the delivery email -------------------------------------
# OPTIONAL. Leave blank to deliver with Zapier instead — /handout/generate then
# returns handout_url in its response for the automation to email. See ZAPIER.md.
# Settings > Developer. No /api/3 suffix on the base URL.
AC_BASE_URL=
AC_API_KEY=
# Personalisation tags of two single-line text custom fields. Verify: npm run check:ac
AC_FIELD_HANDOUT_URL=HANDOUT_URL
AC_FIELD_HANDOUT_USE_CASE=HANDOUT_USE_CASE
# The automation triggers on this tag. Set it to run MULTIPLE TIMES.
AC_READY_TAG=handout-ready

# --- storage ---------------------------------------------------------------
# Unset R2_* and PDFs stay in /output and are served from there.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# --- guard rails (defaults are sensible) -----------------------------------
DISCOUNT_CODE_MAX_LENGTH=20
# Set false ONLY for offline testing. Production must never print a QR code
# pointing at a link that does not resolve.
REFERRAL_LINK_CHECK=true
REFERRAL_LINK_OK_STATUSES=200,301,302,307,308

# --- exception queue (optional; failures always hit logs/exceptions.jsonl) --
MONDAY_API_KEY=
MONDAY_EXCEPTION_BOARD_ID=
MONDAY_EXCEPTION_GROUP_ID=
EXCEPTION_NOTIFY_EMAIL=
EXCEPTION_FROM_EMAIL=no-reply@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
